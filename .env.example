# ==============================================================================
# MedFlow - Arquivo de Exemplo de Configuração de Ambiente (.env)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. NUNCA comite o arquivo .env preenchido com senhas de produção para o Git!
# 3. Em produção corporativa, os segredos são injetados via Kubernetes Secrets
#    ou External Secrets Operator integrado com HashiCorp Vault / AWS Secrets Manager.
# ==============================================================================

# Segredo Criptográfico JWT (Mínimo de 256 bits para HMAC-SHA256)
# Gere uma chave segura, ex: openssl rand -hex 32
JWT_SECRET=dev_insecure_dummy_key_for_local_testing_min_32_bytes_long!!
JWT_EXPIRATION=86400000

# Banco de Dados PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/medflow
DATABASE_USERNAME=medflow
DATABASE_PASSWORD=medflow

# Broker de Mensageria RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# URLs dos Microsserviços
MEDFLOW_CORE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8082
API_GATEWAY_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
